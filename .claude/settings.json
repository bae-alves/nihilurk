{
  "extraKnownMarketplaces": {
    "claude-skillz": {
      "source": {
        "source": "github",
        "repo": "NTCoding/claude-skillz"
      }
    }
  },
  "enabledPlugins": {
    "track-and-improve@claude-skillz": false
  },
  "permissions": {
    "deny": [
      "Task",
      "Task(Explore)",
      "Agent"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "lua \"$CLAUDE_PROJECT_DIR/.claude/hooks/rustfmt.lua\""
          }
        ]
      }
    ]
  }
}
