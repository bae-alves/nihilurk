/target

# `perf record` and `cargo flamegraph` write these into the working directory.
/perf.data*
/flamegraph.svg

# nihilurk saves as <player name>.sav next to wherever it was started.
*.sav

# Working notes on the architecture (SCS): drafts, not documentation. `docs/`
# is what ships.
/scs-architecture/
# release/package.sh writes tarballs here.
/dist

# Personal Claude Code files. The journal is long and about one person's
# sessions, so a contributor's Claude should not read it. See .claude/README.md.
/.claude/*.local.md
/.claude/settings.local.json
