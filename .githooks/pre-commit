#!/usr/bin/env bash
#
# No Python, no comments in function bodies, and English placeholder tags.
#
# Not run automatically -- git does not trust a repo-tracked hooks directory
# by default. Enable it once per clone:
#
#   git config core.hooksPath .githooks

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged() { git diff --cached --name-only --diff-filter=ACM; }

# 0. No Python. nihilurk is Rust, bash and Lua. Runs first because it is the
# cheapest check and the one with no way to be argued with.
lua .githooks/no_python.lua || exit 1

# 0b. No comments inside function bodies in engine or models.
# A note goes above the function, or on its own line above a closure.
lua .githooks/no_body_comments.lua || exit 1

# Its test builds scratch git repos, so it must not inherit this commit's index.
if staged | grep -qE '^\.githooks/no_body_comments(_test)?\.lua$'; then
    env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE lua .githooks/no_body_comments_test.lua >/dev/null || {
        echo "pre-commit: no_body_comments_test.lua failed -- run: lua .githooks/no_body_comments_test.lua" >&2
        exit 1
    }
fi

# 4. English is placeholder text until a human replaces it. Any `pub fn` or
# `pub const` that en.rs gained since HEAD is tagged `// TODO: placeholder
# English` and re-staged, never refused: a human who writes a real sentence
# deletes the tag in a later commit, and the script leaves HEAD's items alone.
if staged | grep -qx 'strings/src/en.rs'; then
    lua .githooks/tag_english_placeholders.lua | xargs -r git add
fi

exit 0
