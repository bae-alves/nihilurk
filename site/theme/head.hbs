{{!-- mdBook puts this in every page's <head>. Variables: title, description (from book.toml). "@SITE_URL@" is filled in by site/build.lua. --}}
<meta property="og:site_name" content="nihilurk">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:locale" content="en_US">
<meta property="og:image" content="@SITE_URL@og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="nihilurk: a dungeon floor of # walls, a monster pack in green, the status line at the bottom">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="@SITE_URL@og-image.png">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "nihilurk",
  "alternateName": "nihilurk roguelike",
  "applicationCategory": "GameApplication",
  "genre": "Roguelike",
  "operatingSystem": ["Linux", "Windows"],
  "url": "@SITE_URL@",
  "codeRepository": "https://github.com/bae-alves/nihilurk",
  "programmingLanguage": "Rust",
  "license": "https://www.gnu.org/licenses/gpl-3.0.html",
  "inLanguage": ["en", "pt", "es", "ht"],
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
}
</script>
