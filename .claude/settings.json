{
  "extraKnownMarketplaces": {
    "claude-skillz": {
      "source": {
        "source": "github",
        "repo": "NTCoding/claude-skillz"
      }
    }
  },
  "enabledPlugins": {
    "track-and-improve@claude-skillz": false
  },
  "permissions": {
    "deny": [
      "Task",
      "Task(Explore)",
      "Agent"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('file_path',''))\" | { read -r f; case \"$f\" in *.rs) rustfmt --edition 2024 \"$f\" ;; esac; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
