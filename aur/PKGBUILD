# Maintainer: bae <bervillarinho@gmail.com>
pkgname=nihilurk
pkgver=0.1.1
pkgrel=1
pkgdesc="Terminal roguelike about descending thirteen floors to reclaim the Element of Yoord"
arch=('x86_64')
url="https://github.com/bae-alves/nihilurk"
license=('GPL3')
makedepends=('rust')
source=("$pkgname-$pkgver.tar.gz::https://github.com/bae-alves/nihilurk/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('01c54fedea2609e26a9778020f8ae9287106f61c2916486d347be63a132dc964')

prepare() {
    cd "$pkgname-$pkgver"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    # One binary per language (see strings/src/lib.rs) plus the `nihilurk`
    # dispatcher that execs the right one for $LANG. Same target dir each
    # time so shared deps aren't rebuilt four times over.
    for lang in en pt es ht; do
        cargo build --frozen --release -p engine --bin nihilurk \
            --no-default-features --features "lang-$lang"
        cp target/release/nihilurk "target/release/nihilurk-$lang"
    done
    cargo build --frozen --release -p engine --bin nihilurk-dispatch
}

check() {
    cd "$pkgname-$pkgver"
    cargo test --frozen --release --workspace --exclude nihilurk-compat
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/nihilurk-dispatch "$pkgdir/usr/bin/nihilurk"
    for lang in en pt es ht; do
        install -Dm755 "target/release/nihilurk-$lang" "$pkgdir/usr/bin/nihilurk-$lang"
    done
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 doc/nihilurk.6 "$pkgdir/usr/share/man/man6/nihilurk.6"
    install -Dm644 MANUAL.md "$pkgdir/usr/share/doc/$pkgname/MANUAL.md"
}
